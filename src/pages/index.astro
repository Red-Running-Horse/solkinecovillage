---
import SiteLayout from "@/layouts/SiteLayout.astro";
import ProjectRow from "@/components/ProjectRow.astro";
import SourceNote from "@/components/SourceNote.astro";
import { projects } from "@/data/projects";
import { bffDefinition } from "@/data/standards";
---

<SiteLayout>
  <section class="home-hero">
    <div class="hero-field hero-place">
      <div class="contour-field" aria-hidden="true">
        <svg viewBox="0 0 720 720" role="presentation">
          <path d="M-40 130C100 25 180 225 330 120s270-15 440-90" />
          <path d="M-60 220C80 115 190 290 350 205s275 10 430-75" />
          <path d="M-30 340c180-95 230 90 395 15s235 25 390-35" />
          <path d="M-80 455c160-80 255 65 405 25s245 15 430-10" />
          <path d="M-30 570c130-65 225 45 380 25s245 20 405 15" />
        </svg>
      </div>
      <h1>Yucatan biodiversity, in public view.</h1>
      <p class="hero-thesis">
        Sol Kin connects developing projects, community discovery, cooperative
        memory, and credible pathways for restoration in one inspectable field
        atlas.
      </p>
      <div class="button-row">
        <a class="button" href="/projects/">Explore the initiatives</a>
        <a class="button light" href="/communities/">Find a community</a>
        <a class="button light" href="/support/">Volunteer or contribute</a>
      </div>
    </div>

    <div class="transect" aria-hidden="true"><span></span></div>

    <div class="hero-field hero-register">
      <div class="register-heading">
        <p>Three current initiatives</p>
        <span>Documentation in progress</span>
      </div>
      <ol>
        {
          projects.map((project, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <a href={`/projects/${project.slug}/`}>{project.title}</a>
              <small>{project.status}</small>
            </li>
          ))
        }
      </ol>
      <div class="hero-paths">
        <a href="/communities/">
          Find a community <span aria-hidden="true">→</span>
        </a>
        <a href="/learn/accreditation/">
          Follow the standards path <span aria-hidden="true">→</span>
        </a>
        <a href="/cooperative/">
          Read the X-Hazil record <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="evidence-key" aria-labelledby="evidence-heading">
    <div>
      <h2 id="evidence-heading">A network that shows its working.</h2>
      <p>
        The public record is intentionally clear about what the source library
        proves and what still needs confirmation.
      </p>
    </div>
    <dl>
      <div>
        <dt>Source-backed</dt>
        <dd>Traceable to a named document in the project library.</dd>
      </div>
      <div>
        <dt>Brief-confirmed</dt>
        <dd>Named by Sol Kin, with operational details still being assembled.</dd>
      </div>
      <div>
        <dt>Open</dt>
        <dd>Needed before a public claim, listing, booking, or funding path.</dd>
      </div>
    </dl>
  </section>

  <section class="home-projects" aria-labelledby="initiatives-heading">
    <div class="section-title">
      <h2 id="initiatives-heading">The initiatives now entering the record.</h2>
      <p>
        Each field record separates known context from the questions that must
        be answered next.
      </p>
    </div>
    <div class="project-ledger">
      {projects.map((project, index) => <ProjectRow {project} {index} />)}
    </div>
  </section>

  <section class="cooperative-window">
    <div class="cooperative-copy">
      <h2>A forest history with names, dates, and limits.</h2>
      <p>
        The supplied Spanish history documents Ejido X-Hazil y Anexos as a
        55,020-hectare community territory bordering the Sian Ka'an Biosphere
        Reserve. It records forestry, chicle, beekeeping, organization, and a
        long process of community forest management.
      </p>
      <a class="button light" href="/cooperative/">Open the cooperative record</a>
    </div>
    <blockquote lang="es">
      <p>
        “El ejido X-Hazil y Anexos fue fundado en 1936… integrado por tres
        centros de población: Chancah Veracruz, X-Hazil y Uh May.”
      </p>
      <footer>
        Source excerpt · Historia del Ejido X-Hazil Sur · Spanish preserved
      </footer>
    </blockquote>
    <div class="cooperative-facts" aria-label="Source-backed cooperative facts">
      <span><strong>1936</strong> founding recorded</span>
      <span><strong>398</strong> ejidatarios recorded</span>
      <span><strong>3</strong> named settlements</span>
      <span><strong>2005</strong> forest certificate recorded</span>
    </div>
  </section>

  <section class="pathway" aria-labelledby="pathway-heading">
    <div class="pathway-intro">
      <h2 id="pathway-heading">From local care to credible evidence.</h2>
      <p>
        Accreditation and finance are not shortcuts. The path starts with
        community governance and an ecological baseline, then moves through
        monitoring, independent assessment, and only later—where appropriate—
        toward carefully governed finance.
      </p>
    </div>
    <ol>
      <li>
        <strong>Community mandate</strong>
        <span>Confirm stewards, consent, place, purpose, and benefit.</span>
      </li>
      <li>
        <strong>Ecological baseline</strong>
        <span>Record conditions, risks, native biodiversity, and evidence gaps.</span>
      </li>
      <li>
        <strong>Restoration practice</strong>
        <span>Design work around recognized biodiversity principles.</span>
      </li>
      <li>
        <strong>Monitoring</strong>
        <span>Publish methods, observations, changes, and uncertainties.</span>
      </li>
      <li>
        <strong>Independent assessment</strong>
        <span>Choose a relevant standard and prepare for external review.</span>
      </li>
      <li>
        <strong>Governed finance</strong>
        <span>Explore funding or credits only with safeguards and clear rights.</span>
      </li>
    </ol>
    <div class="pathway-links">
      <a href="/learn/biodiversity-economy/">Understand the biodiversity economy</a>
      <a href="/learn/accreditation/">Read the accreditation guide</a>
    </div>
  </section>

  <section class="bff-field">
    <div>
      <h2>BFF means Bioregional Financing Facility.</h2>
      <p>{bffDefinition}</p>
      <SourceNote label="Scope boundary">
        <p>
          The repository establishes BFF as a reference framework. It does not
          establish that Sol Kin currently operates a BFF or issues credits.
        </p>
      </SourceNote>
    </div>
    <a class="bff-link" href="/learn/biodiversity-economy/">
      <span>Read the finance framework</span>
      <strong aria-hidden="true">↗</strong>
    </a>
  </section>

  <section class="community-call">
    <div>
      <h2>The community directory begins with verification.</h2>
      <p>
        The project brief references roughly nine local communities. Names,
        locations, contact paths, and volunteer offers are not yet supported by
        the source library, so no identities are being guessed into place.
      </p>
    </div>
    <div class="community-actions">
      <a class="button" href="/communities/">See how listings are verified</a>
      <a class="button light" href="/support/">Nominate a community</a>
    </div>
  </section>
</SiteLayout>

<style>
  .home-hero {
    background: var(--survey);
    border-bottom: 2px solid var(--ink);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12px minmax(22rem, 0.65fr);
    min-height: calc(100svh - 5.75rem);
    position: relative;
  }

  .hero-field {
    min-width: 0;
    padding: clamp(2rem, 5vw, 5rem) var(--gutter);
    position: relative;
  }

  .hero-place {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  .hero-place h1 {
    max-width: 11ch;
    position: relative;
    z-index: 2;
  }

  .hero-thesis {
    font-size: clamp(1.15rem, 1.8vw, 1.6rem);
    font-weight: 700;
    line-height: 1.3;
    margin: auto 0 var(--space-lg);
    max-width: 47rem;
    position: relative;
    z-index: 2;
  }

  .contour-field {
    inset: 0;
    opacity: 0.28;
    pointer-events: none;
    position: absolute;
  }

  .contour-field svg {
    height: 100%;
    width: 100%;
  }

  .contour-field path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .transect {
    background: var(--ink);
    overflow: hidden;
    position: relative;
  }

  .transect span {
    animation: survey-pass 1.4s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
    background: var(--white);
    height: 18%;
    left: 3px;
    position: absolute;
    top: 0;
    width: 6px;
  }

  @keyframes survey-pass {
    from {
      clip-path: inset(0 0 100% 0);
      transform: translateY(0);
    }
    to {
      clip-path: inset(0 0 0 0);
      transform: translateY(455%);
    }
  }

  .hero-register {
    background: var(--ink);
    color: var(--white);
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .register-heading {
    align-items: baseline;
    border-bottom: 1px solid var(--line-light);
    display: flex;
    justify-content: space-between;
    padding-bottom: var(--space-md);
  }

  .register-heading p,
  .register-heading span {
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    margin: 0;
    text-transform: uppercase;
  }

  .register-heading span {
    color: var(--survey);
    text-align: right;
  }

  .hero-register ol {
    list-style: none;
    margin: var(--space-lg) 0;
    padding: 0;
  }

  .hero-register li {
    border-bottom: 1px solid var(--line-light);
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: 2rem 1fr;
    padding: var(--space-md) 0;
  }

  .hero-register li > span {
    color: var(--survey);
    font-family: var(--font-display);
    font-weight: 900;
  }

  .hero-register li a {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 2.4rem);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  .hero-register li small {
    grid-column: 2;
    text-transform: uppercase;
  }

  .hero-paths {
    display: grid;
  }

  .hero-paths a {
    border-top: 1px solid var(--line-light);
    display: flex;
    font-size: 0.78rem;
    font-weight: 900;
    justify-content: space-between;
    padding: 0.7rem 0;
    text-decoration: none;
    text-transform: uppercase;
  }

  .hero-paths a:hover {
    color: var(--survey);
  }

  .evidence-key {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 0.85fr 1.4fr;
    padding: var(--space-xl) var(--gutter);
  }

  .evidence-key h2 {
    font-size: clamp(2.5rem, 5vw, 4.8rem);
  }

  .evidence-key dl {
    border-top: 2px solid var(--ink);
    margin: 0;
  }

  .evidence-key dl div {
    border-bottom: 1px solid var(--ink);
    display: grid;
    gap: var(--space-md);
    grid-template-columns: minmax(9rem, 0.4fr) 1fr;
    padding: var(--space-md) 0;
  }

  .evidence-key dt {
    font-weight: 900;
    text-transform: uppercase;
  }

  .evidence-key dd {
    margin: 0;
  }

  .section-title {
    align-items: end;
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr minmax(16rem, 0.45fr);
    padding: var(--space-xl) var(--gutter) var(--space-lg);
  }

  .section-title p {
    font-size: 1.15rem;
  }

  .cooperative-window {
    background: var(--forest);
    color: var(--white);
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
  }

  .cooperative-copy,
  .cooperative-window blockquote {
    margin: 0;
    padding: var(--space-xl) var(--gutter);
  }

  .cooperative-window blockquote {
    border-left: 2px solid var(--white);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 4.5rem);
    font-weight: 800;
    line-height: 1.05;
  }

  .cooperative-window blockquote p {
    margin-top: 0;
  }

  .cooperative-window blockquote footer {
    color: var(--paper-blue);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .cooperative-facts {
    border-top: 2px solid var(--white);
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(4, 1fr);
  }

  .cooperative-facts span {
    border-right: 1px solid var(--white);
    padding: var(--space-md) var(--gutter);
  }

  .cooperative-facts strong {
    color: var(--survey);
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 4.5rem);
    line-height: 1;
  }

  .pathway {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: minmax(18rem, 0.65fr) 1.35fr;
    padding: var(--space-xl) var(--gutter);
  }

  .pathway ol {
    counter-reset: steps;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pathway li {
    border-top: 1px solid var(--ink);
    counter-increment: steps;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: 3rem minmax(12rem, 0.45fr) 1fr;
    padding: var(--space-md) 0;
  }

  .pathway li::before {
    content: counter(steps, decimal-leading-zero);
    font-family: var(--font-display);
    font-weight: 900;
  }

  .pathway li:last-child {
    border-bottom: 1px solid var(--ink);
  }

  .pathway li strong {
    text-transform: uppercase;
  }

  .pathway-links {
    display: grid;
    gap: var(--space-sm);
    grid-column: 2;
    grid-template-columns: 1fr 1fr;
  }

  .pathway-links a {
    background: var(--paper-blue);
    border: 2px solid var(--ink);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 900;
    padding: var(--space-md);
    text-transform: uppercase;
  }

  .bff-field {
    background: var(--survey);
    border-top: 2px solid var(--ink);
    display: grid;
    grid-template-columns: 1.5fr 0.5fr;
  }

  .bff-field > div {
    padding: var(--space-xl) var(--gutter);
  }

  .bff-link {
    align-items: end;
    background: var(--ink);
    color: var(--white);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-lg);
    text-decoration: none;
  }

  .bff-link span {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2.7rem);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  .bff-link strong {
    color: var(--survey);
    font-size: 5rem;
  }

  .community-call {
    align-items: end;
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1.3fr 0.7fr;
    padding: var(--space-xl) var(--gutter);
  }

  .community-actions {
    display: grid;
    gap: var(--space-sm);
  }

  @media (max-width: 62rem) {
    .home-hero {
      grid-template-columns: 1fr;
    }

    .transect {
      height: 12px;
    }

    .transect span {
      animation-name: survey-pass-horizontal;
      height: 6px;
      left: 0;
      top: 3px;
      width: 18%;
    }

    @keyframes survey-pass-horizontal {
      from {
        clip-path: inset(0 100% 0 0);
        transform: translateX(0);
      }
      to {
        clip-path: inset(0 0 0 0);
        transform: translateX(455%);
      }
    }

    .hero-place {
      min-height: 42rem;
    }

    .evidence-key,
    .section-title,
    .pathway,
    .bff-field,
    .community-call {
      grid-template-columns: 1fr;
    }

    .pathway-links {
      grid-column: auto;
    }

    .bff-link {
      min-height: 16rem;
    }
  }

  @media (max-width: 48rem) {
    .hero-field {
      padding-block: var(--space-lg);
    }

    .hero-place {
      min-height: max(34rem, calc(100svh - 4.8rem));
    }

    .hero-place h1 {
      font-size: clamp(2.85rem, 13vw, 4.2rem);
      max-width: 100%;
    }

    .hero-register {
      min-height: 38rem;
    }

    .evidence-key dl div,
    .pathway li {
      grid-template-columns: 1fr;
    }

    .pathway li {
      gap: var(--space-xs);
    }

    .pathway-links,
    .cooperative-window,
    .cooperative-facts {
      grid-template-columns: 1fr;
    }

    .cooperative-window blockquote {
      border-left: 0;
      border-top: 2px solid var(--white);
    }

    .cooperative-facts span {
      border-bottom: 1px solid var(--white);
      border-right: 0;
    }
  }
</style>
