---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/data/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = "/brand/sol-kin-logo.webp",
  noindex = false
} = Astro.props;

const baseSite =
  Astro.site ?? new URL("https://replace-with-your-domain.example");
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — Biodiversity field atlas`;
const canonical = new URL(Astro.url.pathname, baseSite);
const socialImage = new URL(image, baseSite);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${baseSite}#organization`,
      name: site.name,
      url: baseSite,
      logo: socialImage
    },
    {
      "@type": "WebSite",
      "@id": `${baseSite}#website`,
      name: site.name,
      url: baseSite,
      inLanguage: "en",
      publisher: { "@id": `${baseSite}#organization` },
      description
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/webp" href="/brand/sol-kin-logo.webp" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <!--
      THESIS: A living transect register joins regional discovery to an evidence ledger; it refuses the generic green hero and card-grid eco site.
      OWN-WORLD: Survey green fields, black rules, cool paper, compressed sans type, status stamps, and a continuous field line.
      STORY: See the initiatives, distinguish documented truth from open work, learn the pathway, then choose how to participate.
      FIRST VIEWPORT: A ruled two-stream field places the regional thesis left, three clear paths right, and the primary project action across the central transect.
      FORM: Grounded direction 7, parallel-streams-merge staging, seed 93a210f9.
    -->
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
